# Template only. The real operator-managed file is created at:
#   /var/lib/cpu-cluster-manager/cluster.local.env
# on the master local filesystem, mode 600, owned by ysadmin.

# Installer replaces this with cluster1 on Ubuntu master / cluster2 on CentOS master.
CLUSTER=AUTODETECT

# Private management network only.
# Format: name@IPv4,name@IPv4,...
# Examples:
#   Cluster 1: kfai-cpu-01@192.168.100.11,kfai-cpu-02@192.168.100.12
#   Cluster 2: kfai-cpu-10@172.20.1.4,kfai-cpu-11@172.20.1.5
NODES=EDIT_ME

# Password-only login for the unified management UI. Leave blank; first install
# generates and stores a random password here. ADMIN_USERNAME is retained only
# as Grafana's internal admin identity and is not requested by the management UI.
ADMIN_USERNAME=clusteradmin
ADMIN_PASSWORD=

# Direct management endpoint. AUTODETECT selects the IPv4 address used by the
# master's default route (the school-facing server IP in the validated clusters).
UI_HOST=AUTODETECT
UI_PORT=8080

# Grafana is embedded at /grafana/ behind the unified UI. Port 3000 remains
# bound to master loopback only for local health/debug access.
GRAFANA_PORT=3000

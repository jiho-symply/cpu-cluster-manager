# This is the only operator-managed local configuration file.
# Copy is normally created automatically by scripts/install-master.sh.
# Keep the real cluster.local.env out of Git (mode 600).

# Logical cluster name shown in the UI and Prometheus labels.
CLUSTER=cluster1

# Compute nodes on the private management network.
# Format: name@IPv4,name@IPv4,...
# SSH port is fixed at 22 for this deployment.
NODES=kfai-cpu-01@192.168.100.11

# FastAPI Basic Auth + initial Grafana admin login.
ADMIN_USERNAME=clusteradmin
# Leave blank on first install to generate a random 32-hex password automatically.
ADMIN_PASSWORD=

# Normally leave these defaults unchanged. Services bind to master loopback.
UI_PORT=8080
GRAFANA_PORT=3000

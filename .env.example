# FastAPI control UI. Keep loopback binds when using SSH tunnels.
UI_BIND=127.0.0.1
UI_PORT=8080
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_BASE_URL=http://127.0.0.1:3000

# FastAPI Basic Auth and initial Grafana admin login.
# install-master.sh replaces this default with a random 32-hex password on first run.
ADMIN_USERNAME=clusteradmin
ADMIN_PASSWORD=change-this-password

# Dedicated Cluster Manager SSH key on the cluster master.
SSH_KEY_PATH=/home/ysadmin/.ssh/cluster-manager_ed25519
SSH_KNOWN_HOSTS_PATH=/home/ysadmin/.ssh/cluster-manager_known_hosts

# Long-term Prometheus archive persistent-block cap.
# install-master.sh overwrites this with 32MB x compute-node count.
# The archive also uses 8MB WAL segments to keep shared transient overhead small.
ARCHIVE_RETENTION_SIZE=320MB

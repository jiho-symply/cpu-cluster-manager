# Master UI bind. Keep 127.0.0.1 if you will access through an SSH tunnel.
UI_BIND=127.0.0.1
UI_PORT=8080

# Required HTTP Basic authentication for the management UI.
ADMIN_USERNAME=clusteradmin
ADMIN_PASSWORD=change-this-password

# Dedicated Cluster Manager SSH key on the Cluster 1 master.
# Keep the private key only on the master; Docker mounts it read-only into the UI container.
SSH_KEY_PATH=/home/ysadmin/.ssh/cluster-manager_ed25519
SSH_KNOWN_HOSTS_PATH=/home/ysadmin/.ssh/cluster-manager_known_hosts

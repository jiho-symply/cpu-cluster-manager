# Master UI bind. Keep 127.0.0.1 if you will access through an SSH tunnel.
UI_BIND=127.0.0.1
UI_PORT=8080

# Required HTTP Basic authentication for the management UI.
ADMIN_USERNAME=clusteradmin
ADMIN_PASSWORD=change-this-password

# Paths on the Cluster 1 master host. These are mounted read-only into the UI container.
SSH_KEY_PATH=/home/ysadmin/.ssh/cluster-ui_ed25519
SSH_KNOWN_HOSTS_PATH=/home/ysadmin/.ssh/cluster-ui_known_hosts
